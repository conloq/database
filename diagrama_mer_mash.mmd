erDiagram
    users ||--o{ recipes : possui
    recipes ||--o{ temperatures : possui
    users ||--o{ lots : possui
    recipes ||--o{ lots : origina
    recipes ||--o{ iodine_configs : configura
    users ||--o{ login_history : registra

    users {
        INT id PK
        VARCHAR name
        VARCHAR email UK
        VARCHAR phone
        VARCHAR password
        VARCHAR url_image
        DATETIME created_at
        DATETIME updated_at
    }
    recipes {
        INT id PK
        VARCHAR name
        INT user_id FK
        DATETIME created_at
        DATETIME updated_at
    }
    temperatures {
        INT id PK
        INT max_temperature_ramp
        INT min_temperature_ramp
        INT max_temperature_limit
        INT min_temperature_limit
        TIME timer
        TIME initialization
        TIME ideal_time
        INT order_ramp
        BOOLEAN active_temperature "adição ainda não aplicada à API"
        INT recipe_id FK
        DATETIME created_at
        DATETIME updated_at
    }
    SequelizeMeta {
        VARCHAR name PK
    }
    lots {
        INT id PK
        VARCHAR name
        INT user_id FK
        INT recipe_id FK
        DATETIME mash_start
        ENUM status "active ou completed; default active"
        DATETIME created_at
        DATETIME updated_at
    }
    iodine_configs {
        INT id PK
        TIME first_collection_time
        TIME test_interval
        INT max_tests
        INT recipe_id FK
        DATETIME created_at
        DATETIME updated_at
    }
    login_history {
        INT id PK
        VARCHAR ip_address
        DATETIME logged_at
        VARCHAR location
        BOOLEAN status "aceita NULL"
        INT user_id FK
        DATETIME created_at
        DATETIME updated_at
    }
