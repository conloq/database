erDiagram
    users ||--o{ recipes : possui
    recipes ||--o{ temperatures : possui
    users ||--o{ lots : possui
    recipes ||--o{ lots : possui

    users {
        INT id PK
        VARCHAR name
        VARCHAR email UK
        VARCHAR phone "nullable"
        VARCHAR password
        VARCHAR url_image "nullable"
        DATETIME created_at
        DATETIME updated_at
    }
    recipes {
        INT id PK
        VARCHAR name
        INT user_id FK
        DATETIME created_at
        DATETIME updated_at
    }
    temperatures {
        INT id PK
        INT max_temperature_ramp
        INT min_temperature_ramp
        INT max_temperature_limit
        INT min_temperature_limit
        TIME timer
        TIME initialization
        TIME ideal_time
        INT order_ramp "nullable"
        INT recipe_id FK
        DATETIME created_at
        DATETIME updated_at
    }
    lots {
        INT id PK
        VARCHAR name
        INT user_id FK
        INT recipe_id FK
        DATETIME mash_start
        ENUM status "active ou completed"
        DATETIME created_at
        DATETIME updated_at
    }
